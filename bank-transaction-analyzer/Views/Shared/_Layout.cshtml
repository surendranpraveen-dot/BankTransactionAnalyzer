<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Bank Transaction Analyzer</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="@Url.Action("Index", "Transaction")">Transactions</a></li>
                <li><a href="@Url.Action("Create", "Transaction")">Create Transaction</a></li>
            </ul>
        </nav>
    </header>
    <div class="container">
        @RenderBody()
    </div>
    <footer>
        <p>&copy; @DateTime.Now.Year - Bank Transaction Analyzer</p>
    </footer>
    <script src="~/js/site.js"></script>
</body>
</html>